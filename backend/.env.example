# ============================================================
# Konfigurasi TIARA Backend
# Salin file ini menjadi ".env" lalu isi nilai sesuai akun Google kamu.
# Selama .env belum diisi, server otomatis berjalan dalam MODE DEMO
# (memakai data contoh) supaya tampilan tetap bisa dicoba.
# ============================================================

# Port server backend
PORT=4000

# ID Spreadsheet Google Sheet tujuan (lihat di URL spreadsheet,
# di antara /d/ dan /edit)
# Contoh URL: https://docs.google.com/spreadsheets/d/INI_ID_NYA/edit
SPREADSHEET_ID=

# --- Kredensial Service Account Google Cloud ---
# Pilih SALAH SATU cara berikut:

# Cara A (disarankan untuk hosting/deploy): tempel seluruh isi file
# JSON service account sebagai satu baris string di sini.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Cara B (disarankan untuk development lokal): simpan file JSON
# service account di komputer kamu, lalu tulis path-nya di sini.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Alamat asal (origin) frontend yang diizinkan mengakses API ini
CORS_ORIGIN=http://localhost:5173

# Target ambang batas indikator (boleh diubah sesuai target resmi fakultas)
TARGET_TEPAT_WAKTU_S1=80
TARGET_TEPAT_WAKTU_S2=80
TARGET_MASA_TUNGGU_BULAN=6
TARGET_RASIO_GAJI_UMR=1.2
